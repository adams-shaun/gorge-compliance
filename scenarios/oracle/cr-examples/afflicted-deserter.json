     "seat": 0,
     "card": "p0:Afflicted Deserter",
     "mana": "CCCR"
    },
    {
     "op": "resolve",
     "expect": [
      {
       "card": "p0:Afflicted Deserter",
       "zone": "battlefield",
       "pt": "3/2",
       "types": [
        "Human",
        "Werewolf"
       ]
      }
     ]
    },
    {
     "op": "cast",
     "seat": 0,
     "card": "p0:Cackling Counterpart",
     "mana": "CUU",
     "targets": [
      "p0:Afflicted Deserter"
     ]
    },
    {
     "op": "resolve",
     "expect": [
      {
       "count": {
        "seat": 0,
        "zone": "battlefield",
        "name": "Werewolf Ransacker",
        "token": true
       },
       "eq": 0
      },
      {
       "count": {
        "seat": 0,
        "zone": "battlefield",
        "name": "Afflicted Deserter",
        "token": true
       },
       "eq": 1
      }
     ]
    },
    {
     "op": "cast",
     "seat": 0,
     "card": "p0:Moonmist",
     "mana": "CG"
    },
    {
     "op": "resolve",
     "expect": [
      {
       "count": {
        "seat": 0,
        "zone": "battlefield",
        "name": "Werewolf Ransacker",
        "token": true
       },
       "eq": 1
      },
      {
       "count": {
        "seat": 0,
        "zone": "battlefield",
        "name": "Afflicted Deserter",
        "token": true
