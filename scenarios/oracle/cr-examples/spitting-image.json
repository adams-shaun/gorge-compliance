{
 "card": "Spitting Image",
 "family": "cr-examples",
 "author": "CR example, restated",
 "oracle_sha": "9c4de4c338b5",
 "scenarios": [
  {
   "name": "copy-token-takes-the-copied-name",
   "cr": [
    "111.4"
   ],
   "why": "The token copies the target creature's copiable characteristics, including its name. Copying Doomed Dissenter produces a token named Doomed Dissenter, not Human Token or Doomed Dissenter Token.",
   "setup": {
    "p0": {
     "hand": [
      "Spitting Image"
     ]
    },
    "p1": {
     "battlefield": [
      "Doomed Dissenter"
     ]
    }
   },
   "steps": [
    {
     "op": "cast",
     "seat": 0,
     "card": "p0:Spitting Image",
     "mana": "CCCCGU",
     "targets": [
      "p1:Doomed Dissenter"
     ]
    },
    {
     "op": "resolve"
    }
   ],
   "expect": [
    {
     "count": {
      "seat": 0,
      "zone": "battlefield",
      "name": "Doomed Dissenter",
      "token": true
     },
     "eq": 1
    },
    {
     "card": "p0:token:Doomed Dissenter",
     "pt": "1/1",
     "types": [
      "Creature",
      "Human"
     ]
    },
    {
     "count": {
      "seat": 0,
      "zone": "battlefield",
      "name": "Human Token",
      "token": true
     },
     "eq": 0
    }
   ]
  }
 ]
}
