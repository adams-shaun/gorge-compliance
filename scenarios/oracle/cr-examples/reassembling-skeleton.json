{
 "card": "Reassembling Skeleton",
 "family": "cr-examples",
 "author": "CR example, restated",
 "oracle_sha": "3e6023f2588c",
 "scenarios": [
  {
   "name": "graveyard-is-the-only-working-zone",
   "cr": [
    "113.6m"
   ],
   "why": "The ability can be activated only while the Skeleton card is in its owner's graveyard: from there it returns tapped, while the same permanent already on the battlefield has no such ability to offer.",
   "setup": {
    "p0": {
     "graveyard": [
      "Reassembling Skeleton"
     ]
    }
   },
   "steps": [
    {
     "op": "activate",
     "seat": 0,
     "card": "p0:Reassembling Skeleton",
     "mana": "CB"
    },
    {
     "op": "resolve",
     "expect": [
      {
       "card": "p0:Reassembling Skeleton",
       "zone": "battlefield",
       "tapped": true
      }
     ]
    },
    {
     "op": "mana",
     "seat": 0,
     "mana": "CB"
    }
   ],
   "expect": [
    {
     "offered": {
      "seat": 0,
      "kind": "activate",
      "card": "p0:Reassembling Skeleton"
     },
     "want": false
    }
   ]
  }
 ]
}
