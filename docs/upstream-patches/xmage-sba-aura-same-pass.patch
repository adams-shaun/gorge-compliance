+package org.mage.test.sba;
+
+import mage.constants.PhaseStep;
+import mage.constants.Zone;
+import org.junit.Assert;
+import org.junit.Test;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+
+/**
+ * CR 704.3: the state-based actions found by one check are performed simultaneously as a single event, and
+ * the check is repeated. An Aura whose enchanted creature dies in this check is still attached to a legal
+ * object when the check is made, so it goes to the graveyard in the repeated check (CR 704.5m), after every
+ * creature that died in the first one, wherever the Aura sits in battlefield order.
+ */
+public class AuraLeavesAfterEnchantedCreatureTest extends CardTestPlayerBase {
+
+    private static final String first = "Grizzly Bears";
+    private static final String second = "Runeclaw Bear";
+    private static final String aura = "Pacifism"; // {1}{W} Aura, enchanted creature can't attack or block
+
+    private void putAuraBetweenTheCreatures() {
+        addCard(Zone.BATTLEFIELD, playerA, first);
+        addCard(Zone.HAND, playerA, aura);
+        addCard(Zone.HAND, playerA, second);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 2);
+        addCard(Zone.BATTLEFIELD, playerA, "Forest", 2);
+
+        // battlefield order: first, aura, second
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, aura, first);
+        waitStackResolved(1, PhaseStep.PRECOMBAT_MAIN);
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, second);
+        waitStackResolved(1, PhaseStep.PRECOMBAT_MAIN);
+    }
+
+    private void assertAuraIsLast() {
+        assertGraveyardCount(playerA, 4);
+        List<String> names = new ArrayList<>();
+        for (UUID id : new ArrayList<>(playerA.getGraveyard())) {
+            names.add(currentGame.getCard(id).getName());
+        }
+        Assert.assertEquals("the Aura leaves in the repeated check, after both creatures",
+                aura, names.get(names.size() - 1));
+    }
+
+    @Test
+    public void test_ToughnessZeroCreatures() {
+        putAuraBetweenTheCreatures();
+        addCard(Zone.HAND, playerA, "Darkness Descends"); // {2}{B}{B}, two -1/-1 counters on each creature
+        addCard(Zone.BATTLEFIELD, playerA, "Swamp", 4);
+
+        castSpell(1, PhaseStep.POSTCOMBAT_MAIN, playerA, "Darkness Descends");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertAuraIsLast();
+    }
+
+    @Test
+    public void test_LethalDamageCreatures() {
+        putAuraBetweenTheCreatures();
+        addCard(Zone.HAND, playerA, "Pyroclasm"); // {1}{R}, 2 damage to each creature
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain", 2);
+
+        castSpell(1, PhaseStep.POSTCOMBAT_MAIN, playerA, "Pyroclasm");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertAuraIsLast();
+    }
+}
