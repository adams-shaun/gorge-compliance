diff --git a/Mage.Tests/src/test/java/org/mage/test/cards/single/mm2/ChampionOfStraySoulsTest.java b/Mage.Tests/src/test/java/org/mage/test/cards/single/mm2/ChampionOfStraySoulsTest.java
