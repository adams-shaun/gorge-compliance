diff --git a/engine/effects/remembered_greatest_manacost_test.go b/engine/effects/remembered_greatest_manacost_test.go
new file mode 100644
index 00000000..dc254b4c
--- /dev/null
+++ b/engine/effects/remembered_greatest_manacost_test.go
@@ -0,0 +1,26 @@
+package effects
+
+import (
+	"testing"
+
+	"github.com/adams-shaun/gorge/engine/state"
+)
+
+// TestRememberedGreatestCardManaCost pins the plain Remembered$GreatestCardManaCost
+// read (Alexander, Ship's Fool's X). refTargets has already resolved the ref to
+// its referent set before evalRefProperty's switch; the property, not the ref
+// name, decides the aggregate. At the pin the case is gated to
+// TriggerObjectsCards / TriggerRemembered, so this body hit the switch's default
+// and returned (0, false); the caller degraded to zero.
+func TestRememberedGreatestCardManaCost(t *testing.T) {
+	h := newHost(t, 2)
+	air := mkCard(t, "Name:Air Elemental\nManaCost:3 U U\nTypes:Creature Elemental\nPT:4/4\nOracle:x\n")
+	bears := mkCard(t, "Name:Grizzly Bears\nManaCost:1 G\nTypes:Creature Bear\nPT:2/2\nOracle:x\n")
+	ao := h.g.AddObject(air, 0)
+	bo := h.g.AddObject(bears, 1)
+	c := &Ctx{Source: ao.ID, Controller: 0, Remembered: []state.Target{{Obj: ao.ID}, {Obj: bo.ID}}}
+	got, ok := EvalCountOK(h, c, "Remembered$GreatestCardManaCost")
+	if got != 5 || !ok {
+		t.Fatalf("Remembered$GreatestCardManaCost = %d, ok=%v; want 5, true", got, ok)
+	}
+}
