@@ -0,0 +1,45 @@
+package rules
+
+import (
+	"testing"
+
+	"github.com/adams-shaun/gorge/testkit/testutil"
+)
+
+// TestFarmAlexanderShipsFool is a constructed scenario for the SUP-s356-supp
+// p1.life windows (not a replay): p0 activates Alexander's {T} ability, each
+// player reveals and draws the scripted top card, and X is the greatest mana
+// value among the revealed cards (CR 608.2c; Air Elemental is 5). At
+// GORGE_PIN 5437c13946 the plain Remembered$GreatestCardManaCost ref falls
+// through evalRefProperty's ref-gated case, so the damage is 0 and p1 stays at
+// 20; Forge deals 5.
+func TestFarmAlexanderShipsFool(t *testing.T) {
+	t.Parallel()
+	reg := testutil.CorpusRegistry(t)
+	sc := `{
+	  "name": "farm-alexander-ships-fool-sup-s356",
+	  "turn": 1,
+	  "cr": ["608.2c"],
+	  "why": "Alexander reveals Air Elemental (MV 5) and Grizzly Bears (MV 2); X must be 5, so the random opponent takes 5",
+	  "setup": {
+	    "p0": {"battlefield": ["Alexander, Ship's Fool"], "library_top": ["Air Elemental", "Forest", "Forest"], "life": 20},
+	    "p1": {"library_top": ["Grizzly Bears", "Island", "Island"], "life": 20}
+	  },
+	  "steps": [
+	    {"op": "activate", "seat": 0, "card": "p0:Alexander, Ship's Fool", "ability_index": 0},
+	    {"op": "pass", "seat": 0},
+	    {"op": "pass", "seat": 1}
+	  ]
+	}`
+	res, err := RunOracleScenarioJSON(reg, []byte(sc))
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	if len(res.Fails) != 0 {
+		t.Fatalf("scenario failed: %v", res.Fails)
+	}
+	last := res.Snapshots[len(res.Snapshots)-1]
+	if got := last.Players[1].Life; got != 15 {
+		t.Fatalf("p1.life at %q = %d, want 15 (20 - Air Elemental's mana value 5)", last.Checkpoint, got)
+	}
+}
