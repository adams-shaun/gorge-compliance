+    /**
+     * State key of a trigger limit. A battlefield ability whose source has just
+     * left the battlefield and that looks back in time (CR 603.10a) is still
+     * the ability that triggered before the move, so it is keyed by the
+     * zone change counter of the permanent it is on (last known information),
+     * not by the counter the card has now.
+     */
+    private String getLimitKey(String text, Game game) {
+        if (getZone() == Zone.BATTLEFIELD) {
+            Permanent permanent = game.getPermanentOrLKIBattlefield(getSourceId());
+            if (permanent != null) {
+                return CardUtil.getObjectZoneString(text, getSourceId(), game, permanent.getZoneChangeCounter(game), false);
+            }
+        }
+        return CardUtil.getCardZoneString(text, getSourceId(), game);
     }
 
