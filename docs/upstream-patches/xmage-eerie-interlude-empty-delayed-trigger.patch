+package org.mage.test.cards.single;
+
+import mage.abilities.common.delayed.AtTheBeginOfNextEndStepDelayedTriggeredAbility;
+import mage.constants.PhaseStep;
+import mage.constants.Zone;
+import org.junit.Assert;
+import org.junit.Test;
+import org.mage.test.player.TestPlayer;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+/**
+ * CR 603.7a: an effect may create a delayed triggered ability that does
+ * something at a later time. Eerie Interlude's return sentence is
+ * unconditional, so the delayed ability is created even when zero creatures
+ * are exiled; it then resolves doing nothing.
+ */
+public class EerieInterludeTest extends CardTestPlayerBase {
+
+    private static final String interlude = "Eerie Interlude";
+
+    @Test
+    public void test_DelayedReturnTriggerWithZeroTargets() {
+        setStrictChooseMode(true);
+
+        addCard(Zone.HAND, playerA, interlude);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 3);
+        addCard(Zone.BATTLEFIELD, playerA, "Grizzly Bears");
+
+        // "any number of target creatures" allows choosing zero targets.
+        addTarget(playerA, TestPlayer.TARGET_SKIP);
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, interlude);
+
+        runCode("delayed return trigger at the beginning of the next end step", 1, PhaseStep.END_TURN, playerA,
+                (info, player, game) -> {
+                    Assert.assertEquals("one delayed ability on the stack", 1, game.getStack().size());
+                    Assert.assertTrue("the delayed return ability is on the stack",
+                            game.getStack().getFirstOrNull().getStackAbility() instanceof AtTheBeginOfNextEndStepDelayedTriggeredAbility);
+                });
+
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        // Nothing was exiled, so the trigger resolved doing nothing.
+        assertPermanentCount(playerA, "Grizzly Bears", 1);
+        assertExileCount(playerA, 0);
+    }
+}
