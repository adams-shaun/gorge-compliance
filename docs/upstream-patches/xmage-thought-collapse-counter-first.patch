index 00000000000..5d1fb596cd7
--- /dev/null
+++ b/Mage.Tests/src/test/java/org/mage/test/cards/abilities/oneshot/counterspell/CounterThenMillOrderTest.java
@@ -0,0 +1,71 @@
+package org.mage.test.cards.abilities.oneshot.counterspell;
+
+import mage.cards.Card;
+import mage.constants.PhaseStep;
+import mage.constants.Zone;
+import org.junit.Assert;
+import org.junit.Test;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.stream.Collectors;
+
+/**
+ * "Counter target spell. Its controller mills three cards." The instructions
+ * run in printed order (CR 608.2c): the countered spell is in the graveyard
+ * first (CR 701.6a), then the three milled cards go on top of it. Two separate
+ * events, so the owner has no CR 404.3 choice of order.
+ * <p>
+ * Thought Collapse and Didn't Say Please share the counter-then-mill effect;
+ * both used to mill before they countered, which put the countered spell last.
+ */
+public class CounterThenMillOrderTest extends CardTestPlayerBase {
+
+    private static final String BOLT = "Lightning Bolt";
+    private static final String THOUGHT_COLLAPSE = "Thought Collapse";
+    private static final String DIDNT_SAY_PLEASE = "Didn't Say Please";
+
+    private List<String> graveyardNames() {
+        return currentGame.getPlayer(playerA.getId()).getGraveyard()
+                .getCards(currentGame)
+                .stream()
+                .map(Card::getName)
+                .collect(Collectors.toList());
+    }
+
+    private void counterThenMill(String counterspell) {
+        skipInitShuffling();
+        removeAllCardsFromLibrary(playerA);
+
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain");
+        addCard(Zone.HAND, playerA, BOLT);
+        addCard(Zone.BATTLEFIELD, playerB, "Island", 3);
+        addCard(Zone.HAND, playerB, counterspell);
+        // addCard(Zone.LIBRARY) puts the last added card on top
+        addCard(Zone.LIBRARY, playerA, "Plains");
+        addCard(Zone.LIBRARY, playerA, "Island");
+        addCard(Zone.LIBRARY, playerA, "Plains");
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, BOLT, playerB);
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerB, counterspell, BOLT);
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.BEGIN_COMBAT);
+        execute();
+
+        Assert.assertEquals("the countered spell is in the graveyard before the three milled cards",
+                Arrays.asList(BOLT, "Plains", "Island", "Plains"), graveyardNames());
+        assertGraveyardCount(playerB, counterspell, 1);
+    }
+
+    @Test
+    public void testThoughtCollapseCountersBeforeMilling() {
+        counterThenMill(THOUGHT_COLLAPSE);
+    }
+
+    @Test
+    public void testDidntSayPleaseCountersBeforeMilling() {
+        counterThenMill(DIDNT_SAY_PLEASE);
+    }
+}
diff --git a/Mage/src/main/java/mage/abilities/effects/common/CounterTargetThenMillEffect.java b/Mage/src/main/java/mage/abilities/effects/common/CounterTargetThenMillEffect.java
new file mode 100644
index 00000000000..63747fd3750
--- /dev/null
+++ b/Mage/src/main/java/mage/abilities/effects/common/CounterTargetThenMillEffect.java
@@ -0,0 +1,50 @@
+package mage.abilities.effects.common;
+
+import mage.abilities.Ability;
+import mage.abilities.effects.OneShotEffect;
+import mage.constants.Outcome;
+import mage.game.Game;
+import mage.players.Player;
+
+import java.util.UUID;
+
+/**
+ * "Counter target spell. Its controller mills N cards."
+ * <p>
+ * The instructions are carried out in printed order (CR 608.2c): the countered
+ * spell goes to its owner's graveyard first (CR 701.6a), then the milled cards
+ * go on top of it. The target's controller is read before the counter because
+ * the stack object is gone once the spell has been countered.
+ */
+public class CounterTargetThenMillEffect extends OneShotEffect {
+
+    private final int millAmount;
+
+    public CounterTargetThenMillEffect(int millAmount, String text) {
+        super(Outcome.Benefit);
+        this.millAmount = millAmount;
+        this.staticText = text;
+    }
+
+    protected CounterTargetThenMillEffect(final CounterTargetThenMillEffect effect) {
+        super(effect);
+        this.millAmount = effect.millAmount;
+    }
+
+    @Override
+    public CounterTargetThenMillEffect copy() {
+        return new CounterTargetThenMillEffect(this);
+    }
+
+    @Override
+    public boolean apply(Game game, Ability source) {
+        UUID targetId = source.getFirstTarget();
+        Player controller = targetId == null ? null : game.getPlayer(game.getControllerId(targetId));
+        if (controller == null) {
+            return false;
+        }
+        boolean countered = new CounterTargetEffect().apply(game, source);
+        controller.millCards(millAmount, source, game);
+        return countered;
+    }
+}
