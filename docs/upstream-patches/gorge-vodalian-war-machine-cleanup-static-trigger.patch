+// hasStackBoundPendingTrigger reports whether any queued trigger will be
+// put on the stack: a Static$ True registration whose body is provably
+// ask-free is resolved off the stack by resolveStaticTriggers and is not a
+// triggered ability waiting (CR 514.3a), so it does not count. Everything
+// else -- including a Static$ True body that may ask, which keeps the stack
+// path -- does.
+//
+// It shares staticTriggerLine and staticTriggerAskFree with
+// resolveStaticTriggers, so the registrations this predicate ignores are
+// exactly the ones the drain consumes off the stack; a new static shape is
+// classified in one place for both. The predicate only reads: it does not
+// pop, reorder or resolve anything, so it can be asked before the drain
+// (whose dropDepartedTriggers/dropSetupEntryTriggers preconditions must
+// still decide what is actually resolved).
+func (e *Engine) hasStackBoundPendingTrigger() bool {
+	for _, pt := range e.pendingTriggers {
+		line, svars, self, ok := e.staticTriggerLine(pt)
+		if ok && e.staticTriggerAskFree(pt, line, svars, self) {
+			continue
+		}
+		return true
+	}
+	return false
+}
