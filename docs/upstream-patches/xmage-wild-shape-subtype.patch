+package org.mage.test.cards.single.afr;
+
+import mage.abilities.keyword.HexproofAbility;
+import mage.abilities.keyword.ReachAbility;
+import mage.abilities.keyword.TrampleAbility;
+import mage.constants.PhaseStep;
+import mage.constants.SubType;
+import mage.constants.Zone;
+import org.junit.Test;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+/**
+ * Wild Shape (AFR): "Choose one. Until end of turn, target creature you control
+ * has that base power and toughness, becomes that creature type, and gains that
+ * ability."
+ * <p>
+ * CR 205.1a: an effect that sets one or more of an object's subtypes replaces
+ * the existing subtypes from the appropriate set, so the target becomes the
+ * chosen creature type instead of keeping its printed creature types.
+ * CR 613.1d: that change is applied in layer 4.
+ */
+public class WildShapeTest extends CardTestPlayerBase {
+
+    private static final String wildShape = "Wild Shape";
+    private static final String memnite = "Memnite"; // artifact creature Construct 1/1
+
+    private void castInMode(String mode) {
+        addCard(Zone.BATTLEFIELD, playerA, "Forest");
+        addCard(Zone.BATTLEFIELD, playerA, memnite);
+        addCard(Zone.HAND, playerA, wildShape);
+        setModeChoice(playerA, mode);
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, wildShape, memnite);
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.BEGIN_COMBAT);
+        execute();
+    }
+
+    @Test
+    public void testTurtleMode() {
+        castInMode("1"); // 1/3 Turtle with hexproof
+
+        assertPowerToughness(playerA, memnite, 1, 3);
+        assertSubtype(memnite, SubType.TURTLE);
+        assertNotSubtype(memnite, SubType.HUMAN);
+        assertNotSubtype(memnite, SubType.CONSTRUCT);
+        assertAbility(playerA, memnite, HexproofAbility.getInstance(), true);
+    }
+
+    @Test
+    public void testSpiderMode() {
+        castInMode("2"); // 1/5 Spider with reach
+
+        assertPowerToughness(playerA, memnite, 1, 5);
+        assertSubtype(memnite, SubType.SPIDER);
+        assertNotSubtype(memnite, SubType.HUMAN);
+        assertNotSubtype(memnite, SubType.CONSTRUCT);
+        assertAbility(playerA, memnite, ReachAbility.getInstance(), true);
+    }
+
+    @Test
+    public void testElephantMode() {
+        castInMode("3"); // 3/3 Elephant with trample
+
+        assertPowerToughness(playerA, memnite, 3, 3);
+        assertSubtype(memnite, SubType.ELEPHANT);
+        assertNotSubtype(memnite, SubType.HUMAN);
+        assertNotSubtype(memnite, SubType.CONSTRUCT);
+        assertAbility(playerA, memnite, TrampleAbility.getInstance(), true);
+    }
+}
