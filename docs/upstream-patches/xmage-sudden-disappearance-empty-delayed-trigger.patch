+++ b/Mage.Tests/src/test/java/org/mage/test/cards/single/SuddenDisappearanceTest.java
@@ -0,0 +1,57 @@
+package org.mage.test.cards.single;
+
+import mage.abilities.common.delayed.AtTheBeginOfNextEndStepDelayedTriggeredAbility;
+import mage.constants.PhaseStep;
+import mage.constants.Zone;
+import org.junit.Assert;
+import org.junit.Test;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+/**
+ * CR 603.7a: the resolving spell creates the delayed "return the exiled cards" ability
+ * whether or not anything was exiled; with nothing exiled it triggers and returns nothing.
+ */
+public class SuddenDisappearanceTest extends CardTestPlayerBase {
+
+    private static final String disappearance = "Sudden Disappearance";
+
+    @Test
+    public void test_DelayedReturnTriggerWhenTargetPlayerControlsNothing() {
+        setStrictChooseMode(true);
+
+        addCard(Zone.HAND, playerA, disappearance);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 6);
+        // playerB controls only lands, no nonland permanents
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, disappearance, playerB);
+
+        runCode("delayed return trigger at the beginning of the next end step", 1, PhaseStep.END_TURN, playerA,
+                (info, player, game) -> {
+                    Assert.assertEquals("one delayed ability on the stack", 1, game.getStack().size());
+                    Assert.assertTrue("the delayed return ability is on the stack",
+                            game.getStack().getFirstOrNull().getStackAbility() instanceof AtTheBeginOfNextEndStepDelayedTriggeredAbility);
+                });
+
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertExileCount(playerB, 0);
+    }
+
+    @Test
+    public void test_ReturnsExiledPermanentsAtEndStep() {
+        addCard(Zone.HAND, playerA, disappearance);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 6);
+        addCard(Zone.BATTLEFIELD, playerB, "Grizzly Bears");
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, disappearance, playerB);
+
+        checkExileCount("bears exiled", 1, PhaseStep.POSTCOMBAT_MAIN, playerB, "Grizzly Bears", 1);
+
+        setStopAt(2, PhaseStep.UPKEEP);
+        execute();
+
+        assertPermanentCount(playerB, "Grizzly Bears", 1);
+        assertExileCount(playerB, 0);
+    }
+}
