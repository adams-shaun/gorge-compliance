+package org.mage.test.cards.single;
+
+import mage.abilities.common.delayed.AtTheBeginOfNextEndStepDelayedTriggeredAbility;
+import mage.constants.PhaseStep;
+import mage.constants.Zone;
+import org.junit.Assert;
+import org.junit.Test;
+import org.mage.test.player.TestPlayer;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+/**
+ * CR 603.7a: the attack trigger's resolution creates the delayed "sacrifice those
+ * tokens" ability whether or not a token was made. With no exiled card to copy,
+ * the ability still triggers at the beginning of the end step (and sacrifices nothing).
+ */
+public class MarduSiegebreakerTest extends CardTestPlayerBase {
+
+    private static final String siegebreaker = "Mardu Siegebreaker";
+
+    @Test
+    public void test_DelayedSacrificeTriggerWithNothingExiled() {
+        setStrictChooseMode(true);
+
+        addCard(Zone.HAND, playerA, siegebreaker);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains");
+        addCard(Zone.BATTLEFIELD, playerA, "Mountain");
+        addCard(Zone.BATTLEFIELD, playerA, "Swamp");
+        addCard(Zone.BATTLEFIELD, playerA, "Wastes");
+
+        // "up to one other target creature you control": choose none.
+        addTarget(playerA, TestPlayer.TARGET_SKIP);
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, siegebreaker);
+        attack(1, playerA, siegebreaker); // haste
+
+        runCode("delayed sacrifice trigger at the beginning of the end step", 1, PhaseStep.END_TURN, playerA,
+                (info, player, game) -> {
+                    Assert.assertEquals("one delayed ability on the stack", 1, game.getStack().size());
+                    Assert.assertTrue("the delayed sacrifice ability is on the stack",
+                            game.getStack().getFirstOrNull().getStackAbility() instanceof AtTheBeginOfNextEndStepDelayedTriggeredAbility);
+                });
+
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        // No token was made, so the trigger sacrifices nothing.
+        assertPermanentCount(playerA, siegebreaker, 1);
+    }
+}
